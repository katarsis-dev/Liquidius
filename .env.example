# ─── Free-tier defaults ─────────────────────────────────────────────────────
# Sistem jalan tanpa Docker/Redis/Postgres/Helius. Cukup Node + pnpm.
# Sumber data: Dexscreener API (free tier, ~60 req/min limit).

# Set true untuk inject fake alert tiap 5 detik (buat lihat UI aja tanpa network)
DEV_FIXTURE_ALERTS=false

# ─── Telegram Bot (opsional) ────────────────────────────────────────────────
# Kalau di-set, alert juga ke-push ke Telegram chat. Kalau kosong, cuma web UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_DEGEN=
TELEGRAM_CHAT_ID_MEDIUM=
TELEGRAM_CHAT_ID_SAFE=

# ─── Helius (opsional, buat detect pump.fun launches real-time) ─────────────
# Free tier: signup https://helius.dev, dapat 1M credits/bulan (~33k/hari).
# Kalau di-set, sistem juga subscribe WS pump.fun program logs → detect
# token baru pre/post migrate dgn latency ~2-5 detik.
# Kalau kosong: sistem cuma pakai Dexscreener polling (ga akan detect
# fresh launch <10 menit yg belum listed di Raydium).
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Toggle cepat: set true untuk matiin Helius listener tanpa hapus API key
# di atas. Berguna kalau lagi kena rate limit / mau irit credit.
DISABLE_HELIUS=false
