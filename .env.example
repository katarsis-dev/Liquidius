# ─── Solana / Helius ────────────────────────────────────────────────────────
# WAJIB. Ambil dari https://helius.dev — plan minimal Developer utk latency <5s.
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# Opsional: Birdeye untuk price/holder aggregation
BIRDEYE_API_KEY=

# ─── Telegram Bot ───────────────────────────────────────────────────────────
# Buat bot lewat @BotFather, ambil token
TELEGRAM_BOT_TOKEN=
# ID chat/channel per mode (bisa group ID atau channel ID)
TELEGRAM_CHAT_ID_DEGEN=
TELEGRAM_CHAT_ID_MEDIUM=
TELEGRAM_CHAT_ID_SAFE=

# ─── Web UI ─────────────────────────────────────────────────────────────────
# Token admin utk edit watchlist/settings (single-user, taruh string random panjang)
WEB_ADMIN_TOKEN=change-me-to-random-64-chars
# Public URL screener API dari sisi Next.js (dev: http://localhost:8080)
SCREENER_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=Liquidius

# ─── Datastore ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://liquidius:liquidius@localhost:5432/liquidius
REDIS_URL=redis://localhost:6379

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
SCREENER_HTTP_PORT=8080
# Set true di dev untuk inject fixture alert ke SSE tiap 5s (skip Helius)
DEV_FIXTURE_ALERTS=false
