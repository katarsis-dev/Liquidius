# ─── Free-tier defaults ─────────────────────────────────────────────────────
# Sistem jalan tanpa Docker/Redis/Postgres/Helius. Cukup Node + pnpm.
# Sumber data: Dexscreener API (free tier, ~60 req/min limit).

# Set true untuk inject fake alert tiap 5 detik (buat lihat UI aja tanpa network)
DEV_FIXTURE_ALERTS=false

# ─── Telegram Bot (opsional) ────────────────────────────────────────────────
# Kalau di-set, alert juga ke-push ke Telegram chat. Kalau kosong, cuma web UI.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID_DEGEN=
TELEGRAM_CHAT_ID_MEDIUM=
TELEGRAM_CHAT_ID_SAFE=

# ─── Helius (opsional, buat P1 safety enrichment) ───────────────────────────
# Kosongkan kalau lu free-tier only. Field on-chain (mint authority,
# top10 holders, LP burn) bakal `unknown` tapi web UI tetep jalan.
HELIUS_API_KEY=
HELIUS_RPC_URL=
