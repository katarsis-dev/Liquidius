{
  "name": "liquidius",
  "version": "0.1.0",
  "private": true,
  "description": "Solana token screener & alert system with live web dashboard.",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter screener build && pnpm --filter web build",
    "dev:screener": "pnpm --filter screener dev",
    "dev:web": "pnpm --filter web dev",
    "dev": "concurrently -k -n screener,web -c cyan,magenta \"pnpm dev:screener\" \"pnpm dev:web\"",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "config:lint": "tsx scripts/lint-modes.ts",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "prettier": "^3.2.5",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  }
}
