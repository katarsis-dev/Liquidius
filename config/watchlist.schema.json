{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TrackedWatchlist",
  "type": "object",
  "required": ["label", "wallets"],
  "properties": {
    "label": { "enum": ["smart", "sniper", "caller"] },
    "note":  { "type": "string" },
    "wallets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["address"],
        "properties": {
          "address": { "type": "string", "minLength": 32, "maxLength": 48 },
          "alias":   { "type": "string" },
          "source":  { "type": "string" },
          "addedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
